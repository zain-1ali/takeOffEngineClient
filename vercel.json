{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://take-off-engine-server-three.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://take-off-engine-server-three.vercel.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
